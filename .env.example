# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# Neon dashboard → Connection string (pooled). @neondatabase/serverless kullanır.
DATABASE_URL=

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Derinay

# ─── Auth (next-auth v5 — ZORUNLU) ──────────────────────────────────────────
# Bunlar olmadan giriş çalışmaz; production'da deploy ÖNCESİ Vercel'e ekle.
# AUTH_SECRET üret: openssl rand -base64 32
AUTH_SECRET=
# Tek kullanıcılı panel parolası (Simay'ın giriş parolası)
APP_PASSWORD=
