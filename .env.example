# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# Neon dashboard → Connection string (pooled). @neondatabase/serverless kullanır.
DATABASE_URL=

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Derinay

# ─── Auth (ileride — next-auth v5) ──────────────────────────────────────────
# İlk sürümde kullanılmıyor. Eklenince doldur: openssl rand -base64 32
# AUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
